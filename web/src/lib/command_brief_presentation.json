  "legend": [
    {"title": "Hungary relevance (HU)", "items": [
      ["HIGH", "Directly affects Hungary, its airspace, MH capability planning or NATO's Central/Eastern European air posture."],
      ["MEDIUM", "Affects the regional air picture or Allied posture around Hungary, but not Hungary directly."],
      ["LOW", "A weak or indirect tie (distant actor, supplier link, doctrinal interest)."],
      ["MINIMAL", "No direct link to Hungary, MH or NATO Central/Eastern Europe identified."]]},
    {"title": "Air-power significance (SIG)", "items": [
      ["1/5", "Routine; no capability effect."],
      ["2/5", "Minor or administrative change."],
      ["3/5", "A real but limited capability change."],
      ["4/5", "A major national capability change."],
      ["5/5", "A change with regional or global strategic weight."]]},
    {"title": "Analytic confidence (CONF)", "items": [
      ["LOW", "First indication; thin or single-source reporting."],
      ["MODERATE", "Credible reporting; not independently confirmed, or a single evidence lineage."],
      ["HIGH", "Multiple independent lineages or authoritative primary evidence."]]},
    {"title": "Effect horizon", "items": [
      ["immediate", "The effect exists now."],
      ["<12 months", "Earliest operational effect within a year."],
      ["1–3 years", "Earliest operational effect in one to three years."],
      [">3 years", "No near-term operational effect."],
      ["unknown", "Timing is not established in reporting."]]},
    {"title": "Collection status", "items": [
      ["ADEQUATE", "At least 4 events from at least 2 sources in 60 days."],
      ["PARTIAL", "Some reporting, below the adequate threshold."],
      ["GAP", "No reporting reached the collection in 60 days; absence of reporting is not evidence of inactivity."],
      ["NO MATERIAL CHANGE IDENTIFIED", "Collection was at least PARTIAL and nothing material was assessed."]]},
    {"title": "Analytical terminology", "items": [
      ["FACT", "What the source states, attributed."],
      ["ASSESSMENT", "Our judgement of what the fact means."],
      ["CAPABILITY DELTA", "What changes in capability terms."],
      ["POLICY / INTENT", "A stated plan or requirement; no commitment."],
      ["FIELDING", "Aircraft or systems are being delivered to units."],
      ["IOC", "Initial operational capability: a first unit can conduct the mission."],
      ["FOC", "Full operational capability at planned scale."],
      ["OPERATIONAL", "Employed in its role (IOC or beyond)."],
      ["NEXT OBSERVABLE", "The next concrete, checkable sign that would confirm or move the assessment."],
      ["INTELLIGENCE GAP", "A question collection could not answer that would change the assessment."]]}
  ],

  "principles": [
    "significance ≠ confidence",
    "procurement ≠ operational capability",
    "delivery ≠ IOC",
    "more articles ≠ more independent lineages",
    "official statement ≠ independent confirmation (state-controlled sources: one attributed lineage)"
  ],

  "maturity_columns": ["Intent", "Committed", "Contracted", "Fielding", "IOC", "FOC"]
