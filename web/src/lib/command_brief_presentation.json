  "register": {
    "title": "Source register — evidence behind each judgement",
    "note": "Each S-xx links to the publication it names (original-language title). Items cite only sources that report their subject directly; official (Tier 1) sources first. Context sources are listed for audit only: never evidence, never a lineage. Published = the article's own publication date, never an event or contract date. One lineage = publications restating one evidence chain.",
    "evidence_roles": {
      "EVIDENCE": "Cited as evidence (Primary official / Corroborating)",
      "CONTEXT_ONLY": "Context — not cited as evidence; not counted in lineage or confidence"
    }
